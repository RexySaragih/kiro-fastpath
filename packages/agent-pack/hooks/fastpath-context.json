{
  "version": "v1",
  "hooks": [
    {
      "name": "fastpath-auto-context",
      "description": "On every user prompt, inject FastPath index hits + memories into agent context (exit 0 STDOUT). Deterministic — no LLM credits.",
      "trigger": "UserPromptSubmit",
      "action": {
        "type": "command",
        "command": "__FASTPATH_INJECT__"
      },
      "timeout": 20,
      "enabled": true
    },
    {
      "name": "fastpath-session-start",
      "description": "On session start: warm embedder, catch up git-changed files, inject index status.",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "__FASTPATH_SESSION_START__"
      },
      "timeout": 30,
      "enabled": true
    },
    {
      "name": "fastpath-file-save",
      "description": "Delta-index a file the moment the agent saves it — keeps retrieval fresh without prompt-time scans.",
      "trigger": "PostFileSave",
      "matcher": "\\.(ts|tsx|js|jsx|mjs|cjs|py|go|java|kt|kts|rs|rb|cs|php|swift|scala|c|h|cc|cpp|hpp|sql|sh|md|mdx|json|yaml|yml|toml)$",
      "action": {
        "type": "command",
        "command": "__FASTPATH_FILE_EVENT__"
      },
      "timeout": 30,
      "enabled": true
    },
    {
      "name": "fastpath-file-create",
      "description": "Delta-index newly created files.",
      "trigger": "PostFileCreate",
      "matcher": "\\.(ts|tsx|js|jsx|mjs|cjs|py|go|java|kt|kts|rs|rb|cs|php|swift|scala|c|h|cc|cpp|hpp|sql|sh|md|mdx|json|yaml|yml|toml)$",
      "action": {
        "type": "command",
        "command": "__FASTPATH_FILE_EVENT_CREATE__"
      },
      "timeout": 30,
      "enabled": true
    },
    {
      "name": "fastpath-file-delete",
      "description": "Remove deleted files from the index.",
      "trigger": "PostFileDelete",
      "matcher": "\\.(ts|tsx|js|jsx|mjs|cjs|py|go|java|kt|kts|rs|rb|cs|php|swift|scala|c|h|cc|cpp|hpp|sql|sh|md|mdx|json|yaml|yml|toml)$",
      "action": {
        "type": "command",
        "command": "__FASTPATH_FILE_EVENT_DELETE__"
      },
      "timeout": 15,
      "enabled": true
    },
    {
      "name": "fastpath-memory-capture",
      "description": "At turn end, save a compact session memory (task + edited files) for future recall. Deterministic — no LLM credits.",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "__FASTPATH_MEMORY_CAPTURE__"
      },
      "timeout": 15,
      "enabled": true
    },
    {
      "name": "fastpath-guardrail",
      "description": "Blocks unscoped repo walks and recursive shell discovery (grep -r / rg / find); substitutes indexed listings; warns on repeated file reads (FASTPATH_GUARDRAIL=off|warn|block|auto).",
      "trigger": "PreToolUse",
      "matcher": "(listDirectory|ListDirectory|listdirectory|list_directory|fileSearch|FileSearch|filesearch|file_search|findFiles|FindFiles|find_files|glob|Glob|globFiles|glob_files|directorySearch|DirectorySearch|directory_search|readFile|read_file|readFiles|read_files|readMultipleFiles|read_multiple_files|fsRead|fs_read|executeBash|execute_bash|executeCommand|execute_command|runCommand|run_command|runShell|run_shell|shell|Shell|bash|Bash)",
      "action": {
        "type": "command",
        "command": "__FASTPATH_GUARDRAIL__"
      },
      "timeout": 10,
      "enabled": true
    }
  ]
}
